{
  "name": "robot-mecanico-control-web",
  "version": "1.0.0",
  "description": "Control web en tiempo real para simulacion de robot DOBOT M1 con registro en MySQL.",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "mcp": "node mcp/server.js",
    "db:init": "mysql -u root -p robot_mecanico < database/schema.sql"
  },
  "keywords": [
    "robot",
    "dobot",
    "mysql",
    "socket.io",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
